# =========================================================================
#                    COMPANY OUTREACH PLATFORM - V3
#                      ENVIRONMENT CONFIGURATION
# =========================================================================
# This file serves as the Single Source of Truth (SSoT) for all environment 
# variables utilized by the FastAPI Gateway, background Celery workers, and
# Celery Beat cron schedulers.
#
# COPY this file to .env in your local development environment.
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE INTELLIGENCE & DATABASE LAYER
# -------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-..."
NEON_DB_URL="postgresql://user:pass@host/dbname?sslmode=require"

# -------------------------------------------------------------------------
# 2. AI COST GOVERNANCE & REQUEST CACHING
# -------------------------------------------------------------------------
# Daily budget cap for combined LLM operations. If reached, calls are blocked.
LLM_DAILY_BUDGET_USD="10.00"

# Enable/Disable Redis-backed SHA-256 prompt closure caching
LLM_CACHE_ENABLED="True"

# Time-To-Live (in seconds) for cached agent responses (default: 24 Hours)
LLM_CACHE_TTL_SECONDS="86400"

# -------------------------------------------------------------------------
# 3. PRODUCTION OBSERVABILITY, METRICS & ALERTS
# -------------------------------------------------------------------------
# Webhook URL for instantaneous Slack/Teams Celery task failure notifications
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Storage mode for file ingestion (e.g. 'local' or 's3')
STORAGE_MODE="local"
AWS_STORAGE_BUCKET_NAME="company-outreach-storage-bucket"

# -------------------------------------------------------------------------
# 4. IDENTITY, SECURITY & SESSION MANAGEMENT
# -------------------------------------------------------------------------
# Base64 AES-256 key for securing mailbox credentials and tokens in the database
ENCRYPTION_KEY="paste_secure_aes_256_base64_encoded_token_here"

# Authentication session signing key
JWT_SECRET="AI_PRIORI_ENTERPRISE_IDENT_SESSION_KEY_PRODUCTION"

# CORS configuration for authorized cross-origin requests
ALLOWED_ORIGINS="http://localhost:5173,https://app.ai-priori.com"

# -------------------------------------------------------------------------
# 5. GOOGLE IDENTITY BRIDGE & STATELESS GMAIL CREDENTIALS
# -------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"
GOOGLE_REDIRECT_URL="http://localhost:5173/connect-mailbox"

# Active access and refresh token state payload (populated during OAuth flow)
GMAIL_TOKEN_JSON='{"token": "ya29...", "refresh_token": "1//...", "token_uri": "...", "client_id": "...", "client_secret": "...", "scopes": ["..."]}'

# -------------------------------------------------------------------------
# 6. CAL.COM GATEWAY & SCHEDULING INTEGRATIONS
# -------------------------------------------------------------------------
CAL_CLIENT_ID="your_cal_client_id_here"
CAL_CLIENT_SECRET="your_cal_client_secret_here"
CAL_REDIRECT_URI="http://localhost:5173/connect-calendar"

# Legacy Cal config (if running in non-OAuth credential fallback mode)
CAL_API_KEY="cal_live_..."
CAL_USERNAME="your-cal-username"
CAL_EVENT_TYPE_ID="5137238" 
CAL_EVENT_LINK="https://cal.com/your-username/30min"

# -------------------------------------------------------------------------
# 7. OUTBOUND SMTP & MAIL BOX HOSTS
# -------------------------------------------------------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-verified-mail@gmail.com"
EMAIL_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM="your-verified-mail@gmail.com"

# -------------------------------------------------------------------------
# 8. DISCOVERY SWARM & AI RESEARCH ENGINE
# -------------------------------------------------------------------------
TAVILY_API_KEY="tvly-..."

# -------------------------------------------------------------------------
# 9. DISTRIBUTED EXECUTION LAYER (REDIS BROKER)
# -------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# -------------------------------------------------------------------------
# 10. STATE-MACHINE TIMERS & NUDGE TUNING COORDINATES
# -------------------------------------------------------------------------
# Number of days to look back for replies before flagging as unresponsive
REPLY_FALLBACK_WINDOW_DAYS="90"

# Maximum minutes allowed for active task locks before reclaiming
NUDGE_DISPATCH_STALE_MINUTES="15"

# Delay in days between consecutive campaign follow-ups
NUDGE_FOLLOWUP_DELAY_DAYS="2"

# Heartbeat timeout in minutes to resurrect stalled orchestrators
SWEEP_STUCK_MINUTES="10"

# Hard limit for consecutive follow-up emails on neutral intent replies
MAX_NEUTRAL_FOLLOWUPS="11"

# 24-Hour booking reminder evaluation range (in hours)
REMINDER_24H_MIN_HOURS="22"
REMINDER_24H_MAX_HOURS="25"

# 1-Hour booking reminder evaluation range (in minutes)
REMINDER_1H_MIN_MINUTES="45"
REMINDER_1H_MAX_MINUTES="75"
