# =============================================================================
# AI-PRIORI — BACKEND ENV
# FastAPI · Celery Workers · Celery Beat
# Copy to backend/.env and fill in every value before starting the server.
# =============================================================================

# --- DATABASE ---
NEON_DB_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- AI / LLM ---
OPENAI_API_KEY=sk-proj-...

# --- SECURITY (generate strong values — never use the placeholders in prod) ---
# openssl rand -base64 32
ENCRYPTION_KEY=paste_base64_aes256_key_here
# openssl rand -hex 32
JWT_SECRET=paste_strong_random_secret_here

# --- DEPLOYMENT ---
ENVIRONMENT=production
FRONTEND_URL=https://app.ai-priori.com
ALLOWED_ORIGINS=https://app.ai-priori.com

# --- REDIS ---
REDIS_URL=redis://localhost:6379/0

# --- GOOGLE OAUTH (backend) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# --- CAL.COM SCHEDULING ---
CAL_CLIENT_ID=your_cal_client_id
CAL_CLIENT_SECRET=your_cal_client_secret
CAL_EVENT_TYPE_ID=5137238
CAL_EVENT_LINK=https://cal.com/your-username/30min

# --- EMAIL / SMTP FALLBACK ---
# Used when a user has not connected their Gmail via OAuth
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=your-email@gmail.com

# --- SLACK ALERTS (optional) ---
# Leave blank to disable task-failure notifications
SLACK_WEBHOOK_URL=

# --- AWS S3 (optional — only needed when STORAGE_MODE=s3) ---
STORAGE_MODE=local
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=company-outreach-storage-bucket
